# WebSocket URL for the system information API (karasu-servers/sysinfo-api).
# 
# Note: When deployed to Cloudflare, this connects to the secure WSS port (443) on nginx.
#       It requires the Cloudflare SSL Origin Certificate, as configured in:
#       /etc/nginx/sites-available/api.karasu.co.uk
#
VITE_WS_URL=ws://localhost:3000/ws
#VITE_WS_URL=wss://api.karasu.co.uk/ws
